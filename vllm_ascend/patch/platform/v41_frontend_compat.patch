+/// Escape V4.1 turn tokens in caller text, preserving generated image markers.
+fn write_content_text(out: &mut String, text: &str, dialect: DsDialect) {
+    if dialect != DsDialect::V41 || !text.contains("<｜") {
+        out.push_str(text);
+        return;
+    }
+    let mut escaped = text.to_owned();
+    for token in [
+        BOS_TOKEN,
+        EOS_TOKEN,
+        USER_SP_TOKEN,
+        ASSISTANT_SP_TOKEN,
+        SYSTEM_SP_TOKEN,
+        "<｜latest_reminder｜>",
+        "<｜action｜>",
+        "<｜query｜>",
+        "<｜authority｜>",
+        "<｜domain｜>",
+        "<｜title｜>",
+        "<｜read_url｜>",
+    ] {
+        escaped = escaped.replace(token, &format!("<\u{200b}{}", &token[1..]));
+    }
+    out.push_str(&escaped);
+}
