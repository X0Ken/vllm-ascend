@@ -7226,3 +7226,49 @@ def test_diffusion_read_deferral_keeps_a_longer_pp_wait():
     # Deferring this step alone would ask for 6. The PP wait to 7 stands.
     assert "read" not in scheduler.schedule().num_scheduled_tokens
     assert read.next_decode_eligible_step == 7
+
+
+@pytest.mark.parametrize("maximum", [1, 2])
+def test_dsv41_admission_gate_separates_existing_decode_from_new_prefills(maximum):
+    scheduler = create_scheduler(max_num_batched_tokens=256)
+    scheduler.admission_gate_enabled = True
+    scheduler._gate_max_prefill = maximum
+    (decode,) = create_requests(1, num_tokens=8, req_ids=["decode"])
+    scheduler.add_request(decode)
+    output = scheduler.schedule()
+    scheduler.update_from_output(
+        output,
+        ModelRunnerOutput(
+            req_ids=["decode"],
+            req_id_to_index={"decode": 0},
+            sampled_token_ids=[[0]],
+            logprobs=None,
+            prompt_logprobs_dict={},
+            pooler_output=[],
+        ),
+    )
+    for request in create_requests(3, num_tokens=8, req_ids=["p0", "p1", "p2"]):
+        scheduler.add_request(request)
+    output = scheduler.schedule()
+    assert "decode" not in output.num_scheduled_tokens
+    assert len(output.num_scheduled_tokens) == maximum
+    # Forced decode-only steps must keep the waiting prefills queued.
+    waiting_ids = {request.request_id for request in scheduler.waiting}
+    scheduler._gate_force_decode_steps = 1
+    output = scheduler.schedule()
+    assert "decode" in output.num_scheduled_tokens
+    assert waiting_ids.isdisjoint(output.num_scheduled_tokens)
+
+
+def test_dsv41_admission_gate_retries_decode_when_prefill_cannot_allocate(monkeypatch):
+    scheduler = create_scheduler(max_num_batched_tokens=256)
+    scheduler.admission_gate_enabled = True
+    for request in create_requests(1, num_tokens=8):
+        scheduler.add_request(request)
+    monkeypatch.setattr(
+        scheduler.kv_cache_manager, "allocate_slots", lambda *_a, **_kw: None
+    )
+    output = scheduler.schedule()
+    assert output.total_num_scheduled_tokens == 0
+    assert scheduler._gate_force_decode_steps == 2
+    assert len(scheduler.waiting) == 1
