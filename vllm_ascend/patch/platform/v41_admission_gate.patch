+    def _gate_has_prefill_work(self) -> bool:
+        """Whether any request could be scheduled as prefill work this step.
+
+        A running prefill chunk always counts (it already holds blocks). A
+        waiting request only counts if there is room in the running batch and
+        the request is not currently blocked on an external dependency.
+        """
+        if any(self._gate_is_prefill_request(req) for req in self.running):
+            return True
+        num_running = len(self.running) + self.num_waiting_for_streaming_input
+        if num_running >= self.max_num_active_reqs:
+            return False
+        for queue in (self.kv_holding_waiting, self.waiting):
+            for request in queue:
+                if self._is_blocked_waiting_status(request.status):
+                    continue
+                if (
+                    request.num_stale_output_tokens > 0
+                    and not request.drop_stale_output
+                ):
+                    continue
+                if self._gate_is_prefill_request(request):
+                    return True
+        return False
